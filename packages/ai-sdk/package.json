{
  "name": "anansi-ai-sdk",
  "version": "0.3.1",
  "engines": {
    "node": ">=20"
  },
  "description": "Vercel AI SDK middleware for Anansi — inject persistent, synthesized user memory into any model and auto-ingest conversation turns",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["memory", "llm", "ai", "ai-sdk", "vercel", "middleware", "anansi"],
  "license": "MIT",
  "author": "Anansi",
  "homepage": "https://github.com/g-33-L/anansi",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-33-L/anansi.git",
    "directory": "packages/ai-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
