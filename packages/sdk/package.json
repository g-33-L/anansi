{
  "name": "anansi-memory",
  "version": "0.3.1",
  "engines": {
    "node": ">=20"
  },
  "description": "The memory layer for AI apps — persistent, synthesized context for any LLM application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.contract.json",
    "test:types": "tsc --project tsconfig.contract.json",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["memory", "llm", "ai", "rag", "context", "vector", "anansi"],
  "license": "MIT",
  "author": "Anansi",
  "homepage": "https://github.com/g-33-L/anansi",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-33-L/anansi.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
