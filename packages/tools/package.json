{
  "name": "anansi-tools",
  "version": "0.3.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Framework-agnostic memory tools for Anansi — remember/recall tool definitions for the Vercel AI SDK, OpenAI function calling, and any agent framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["memory", "llm", "ai", "tools", "function-calling", "agents", "anansi"],
  "license": "MIT",
  "author": "Anansi",
  "homepage": "https://github.com/g-33-L/anansi",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-33-L/anansi.git",
    "directory": "packages/tools"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
