# ─── Deployment mode ─────────────────────────────────────────────────────────
# Governs provider selection and the privacy guarantee. See DEPLOYMENT.md.
#   local  — air-gapped: local inference + embeddings only, telemetry off.
#            Startup FAILS if CEREBRAS_API_KEY / GITHUB_TOKEN / NOMIC_API_KEY /
#            SENTRY_DSN are set. Nothing leaves the box.
#   cloud  — default (today's behavior). Cloud providers when keys are set.
#   hybrid — explicit mix; set INFERENCE_LOCATION and EMBEDDING_LOCATION.
DEPLOYMENT_MODE=cloud
# Only read in hybrid mode (each: local | cloud). Defaults: cloud / local.
INFERENCE_LOCATION=cloud
EMBEDDING_LOCATION=local

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Optional connectors — each pair enables its sync worker at startup;
# leave blank to keep the connector disabled.
# Notion (create an OAuth integration at notion.so/my-integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Google Docs (create OAuth credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database — Railway: use ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://anansi:anansi@localhost:5432/anansi

# Redis — Railway: use ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# LLM — provider chain: Cerebras → GitHub Models → local Ollama.
# Set exactly one cloud provider key for production; leave both unset to use Ollama locally.
CEREBRAS_API_KEY=
CEREBRAS_QUERY_MODEL=gpt-oss-120b
CEREBRAS_SYNTHESIS_MODEL=gpt-oss-120b

# Fallback: GitHub Models (used when CEREBRAS_API_KEY is unset)
GITHUB_TOKEN=
GITHUB_MODELS_QUERY_MODEL=gpt-4o-mini
GITHUB_MODELS_SYNTHESIS_MODEL=gpt-4o-mini

# Final fallback: local Ollama chat model
OLLAMA_LLM_MODEL=llama3.1:8b

# Embeddings (Nomic API — cloud; falls back to Ollama if NOMIC_API_KEY is unset)
NOMIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRO_PRICE_ID=price_
STRIPE_SCALE_PRICE_ID=price_
# Legacy flat API tier — only needed while grandfathered subscribers remain
STRIPE_API_PRICE_ID=price_
# Stripe Billing Meter event names — create meters in Stripe dashboard, copy event names here
# If unset, overage usage is tracked locally only (not reported to Stripe)
STRIPE_INGEST_METER_EVENT_NAME=
STRIPE_CONTEXT_METER_EVENT_NAME=

# App
APP_URL=https://your-railway-url.up.railway.app

# Encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: never change ENCRYPTION_KEY after first install — all stored tokens are encrypted with it
ENCRYPTION_KEY=
CSRF_SIGNING_KEY=

# API key HMAC secret — generate same as ENCRYPTION_KEY (must be separate from ENCRYPTION_KEY)
API_KEY_HMAC_SECRET=

# Portal auth — Supabase project (create at supabase.com)
# All three are required for /portal login/signup/OTP to work
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Owner account — always enterprise plan, no quota enforcement.
# ENTERPRISE_EMAILS: optional comma-separated additional enterprise accounts.
FOUNDER_EMAIL=
ENTERPRISE_EMAILS=

# STAFF_EMAILS: comma-separated platform-operator accounts for the internal
# operations plane (/console/ops). FAIL-CLOSED: the ops plane is reachable ONLY
# when DEPLOYMENT_MODE=cloud AND this is non-empty. Leave BLANK on self-host/local
# — no one can then reach the operator surface. Staff identity is separate from
# org roles: an org owner has zero ops access. (Phase 8, ADR-0004.)
STAFF_EMAILS=

# Internal API key (protects /metrics endpoint)
QUERY_API_KEY=

# Synthesis trigger (default 25, lower for dev)
SYNTHESIS_THRESHOLD=25

# Error reporting (optional but recommended) — from sentry.io → Project →
# Settings → Client Keys (DSN). Leave blank to disable. NOTE: in
# DEPLOYMENT_MODE=local, SENTRY_DSN must stay unset (startup fails otherwise).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Plan defaults ────────────────────────────────────────────────────────────
# Which plan a workspace gets when it has no subscription row.
# Left unset, a self-hosted install (no STRIPE_SECRET_KEY) defaults to
# "enterprise" — unlimited, nothing expires. The hosted service defaults to
# "free". Set this only if you want to meter your own install.
# ANANSI_DEFAULT_PLAN=enterprise
