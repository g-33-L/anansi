# ── Terraform ────────────────────────────────────────────────────────────────
# Provider plugin cache — ~650 MB per directory, and GitHub rejects any blob
# over 100 MB. Reproduced by `terraform init`.
.terraform/

# State belongs in the S3 backend, never in git. Even when it holds nothing
# sensitive today, state accumulates resource attributes (passwords, keys) as
# the stack grows, and git history cannot be un-leaked.
# NOTE: infra/terraform/bootstrap uses a local backend by necessity — it is the
# stack that creates the S3 bucket. Its state stays on disk only; the bucket and
# lock table are re-importable if lost (see infra/README.md).
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# May contain credentials. Variables are passed with -var / TF_VAR_ instead.
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# .terraform.lock.hcl is intentionally NOT ignored — it pins provider versions
# and must be committed.

# Local scratch notes from agent sessions — never part of the distribution.
memory/
